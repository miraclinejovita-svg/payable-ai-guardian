# ============================================================
# PayAble AI Guardian — Backend Environment Variables Template
# ============================================================
# Copy this file to server/.env  (never commit server/.env to git)
#   cp server/.env.example server/.env
#
# CRITICAL: .env is in .gitignore and must NEVER be committed.
# Never put real API keys or PayPal secrets in this file or any other
# file that is committed to version control.

# ─── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── AI Provider (Phase 4) ───────────────────────────────────
# Supported values: real_gemini | real_openai | offline_fallback
#
# real_gemini  — requires GEMINI_API_KEY (see https://aistudio.google.com/app/apikey)
# offline_fallback — no key needed; uses deterministic regex parser
#
# Verified working model (as of 2026): gemini-2.5-flash
# Free tier subject to Google AI Studio RPM/TPM limits.
AI_PROVIDER=offline_fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=8000

# Alternative (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── PayPal Sandbox (Phase 5) ────────────────────────────────
# SANDBOX ONLY — never use live PayPal credentials here.
# Get sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
#
# 1. Sign in to developer.paypal.com
# 2. Create a Sandbox App under "My Apps & Credentials" > "Sandbox"
# 3. Copy the Client ID and Secret below
# 4. Create a Sandbox personal test account to use as the buyer
#
# Currency note: PayPal REST API v2 discontinued domestic INR payments (April 2021).
# Only USD orders (Order C: Global Software & Tech $15.00) can be tested in Sandbox.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_placeholder
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_placeholder
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
