# PayAble AI Guardian - Environment Variables Template
# Copy this file to .env in the server directory: cp .env.example server/.env
# DO NOT COMMIT REAL SECRETS OR LIVE CREDENTIALS TO GIT.

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# AI Service Configuration
# Supported providers: gemini, openai, or mock (for offline fallback)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# PayPal Sandbox Configuration
# Obtain test credentials from https://developer.paypal.com/dashboard/applications/sandbox
# NEVER USE LIVE PAYPAL CREDENTIALS HERE
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Session and Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
